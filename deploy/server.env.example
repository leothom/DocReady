# Server-only secrets. Copy once to server.env, with mode 600.
# Enter the key in a server editor. Do not put it in chat or a command argument.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
SESSION_SECRET=
PILOT_VERSION=2
# Turn this on only after release checks and publication approval.
PILOT_ENABLED=false
# Required durable daily request limit for all invites, probes and retries.
# Uses Hong Kong calendar days; restarts do not reset it.
# This is not a hard spending cap. Set provider billing alerts as well.
PILOT_DAILY_LIMIT=100
DEEPSEEK_PRICE_TIER=unknown
