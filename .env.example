# Server only. Never prefix secrets with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
APP_ORIGIN=http://localhost:3100
PILOT_INVITE_SECRET=
SESSION_SECRET=
PILOT_VERSION=1
PILOT_ENABLED=true

# Optional daily cap on paid model calls (probe + review). Leave blank for no cap.
# This is a soft guard, not a hard spending cap. Invalid values fail closed (deny all).
PILOT_DAILY_LIMIT=

# Cost stays unknown unless the current provider price tier is confirmed.
DEEPSEEK_PRICE_TIER=unknown
