{
  "name": "docready",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "setup:local": "node scripts/setup-local.mjs",
    "invite": "node --env-file=.env.local scripts/invite.mjs",
    "test:live-review": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "type": "module"
}
